program ::= statement* Eof;

statement ::=
  | expr ";"
  ;

unary_op ::= "+" | "-";
binary_op ::= "+" | "-" | "*" | "/" | "**";

# Ambiguity resolved in precedence.md
expr ::=
  | unary_op expr
  | expr binary_op expr
  | primary_expr;

unary_expr ::= ("+" | "-")? primary_expr;

primary_expr ::= IntLiteral | FloatLiteral | Ident | "(" additive_expr ")";

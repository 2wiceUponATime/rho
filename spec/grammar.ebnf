## Program structure
program ::= declaration* Eof;

sep_list[$item, $sep=","] ::= $item ($sep $item)*;
list[$item, $sep=","] ::= sep_list[$item, $sep] $sep?;

## Statements
statement ::=
  | assignment ";"
  | (Ident ":")? block_expr
  | declaration
  | expr ";"
  ;

## Declarations
declaration ::=
  | variable_decl ";"
  | fn_modifiers "function" Ident "(" params? ")" ("->" type)? statement_block
  | "class" Ident ("extends" type)? "{" class_member* "}"
  ;

class_member ::=
  | class_member_prefix Ident (":" type)? ("=" expr)? ";"
  | class_member_prefix fn_modifiers (Ident | "constructor") "(" params? ")" ("->" type)? statement_block
  ;

class_member_prefix ::= ("private" | "protected")? "static"?;

variable_decl ::=
  | "let" pattern (":" type)? ("=" expr)?
  | "const" pattern (":" type)? "=" expr
  ;

fn_modifiers ::= ("const" | "async")?;

params ::= list[param];

param ::=
  | pattern (":" type)? ("=" expr)?
  | "..." pattern (":" type)?
  ;

## Expressions (ambiguity resolved in precedence.md)
expr ::=
  # Operators
  | unary_op expr
  | expr binary_op expr
  | expr "is" type

  # Postfix
  | expr ("." | "?.") Ident
  | expr "?."? "[" expr "]"
  | expr "?."? "(" list["..."? expr]? ")"
  | expr "!"

  # Control flow
  | "return" expr?
  | "throw" expr
  | "break" (":" Ident)? expr?
  | "continue" (":" Ident)?
  | (Ident ":")? block_expr

  # Functions
  | fn_modifiers "(" params? ")" ("->" type)? "=>" (expr | statement_block)
  | fn_modifiers "function" "(" params? ")" ("->" type)? statement_block

  # Literals and primaries
  | NoSubTemplate
  | TemplateHead (expr TemplateMiddle)* expr TemplateTail
  | "[" list["..."? expr] "]"
  | "(" tuple_elements? ")"
  | "(" expr ")"
  | IntLiteral
  | FloatLiteral
  | StringLiteral
  | "true" | "false" | "null"
  | "this" | "super" | "Self"
  | Ident
  ;

tuple_elements ::= (expr ",")+ expr?;

block_expr ::=
  | "do" block
  | "if" "(" expr ")" block ("else" "if" "(" expr ")" block)* ("else" block)?
  | "match" "(" expr ")" "{" match_arms? "}"
  | "loop" block
  | "while" "(" expr ")" block
  | "for" "(" for_header ")" block
  | "try" block (catch_block+ ("finally" block)? | "finally" block)
  ;


for_header ::=
  | (variable_decl | assignment | expr)? ";" expr? ";" (assignment | expr)?
  | pattern (":" type)? "in" expr
  ;

catch_block ::= "catch" ("(" pattern (":" type)? ")")? block;

block ::= "{" statement* expr? "}";
statement_block ::= "{" statement* "}";

## Patterns (destructuring/match)
pattern ::=
  | "_"
  | Ident
  | literal_pattern
  | type? object_pattern
  | array_pattern
  | "(" ((pattern ",")+ pattern?)? ")"
  | "(" union_pattern ")"
  ;

object_pattern ::= "{" list[Ident (":" pattern)?]? "}";

array_pattern ::= "[" list[pattern | "..." Ident]? "]";

union_pattern ::= "|"? sep_list[pattern, "|"];

literal_pattern ::=
  | "-"? (IntLiteral | FloatLiteral)
  | StringLiteral
  | "true" | "false" | "null"
  ;

## Match
match_arms ::=
  (match_arm_head (block_expr ","? | expr ","))*
  match_arm_head expr ","?
  ;

match_arm_head ::= union_pattern ("if" expr)? "=>";

## Assignment
assignment ::=
  | assign_target "=" expr
  | place compound_assignment_op expr
  ;

# Uses same precedence levels as expr
assign_target ::=
  | "_"
  | place
  | "[" list[assign_target | "..." assign_target]? "]"
  | "{" list[Ident (":" assign_target)?]? "}"
  | "(" (assign_target ",")+ assign_target? ")"
  ;

place ::=
  | Ident
  | expr "." Ident
  | expr "[" expr "]"
  ;

## Operators
unary_op ::= "-" | "!" | "~" | "await";

binary_op ::=
  | "??"
  | "||"
  | "&&"
  | "==" | "!="
  | "<" | "<=" | ">" | ">="
  | "|"
  | "^"
  | "&"
  | "<<" | ">>"
  | "+" | "-"
  | "*" | "/" | "%"
  | "**"
  ;

compound_assignment_op ::=
  | "+=" | "-="
  | "*=" | "/=" | "%="
  | "**="
  | "&=" | "^=" | "|="
  | "&&=" | "||="
  | "<<=" | ">>="
  | "??="
  ;

## Types (TODO)
type ::=
  | Ident
  ;
